@page "/signals/{Id:int}"
@using Openclaw.Dashboard.Services
@inject SignalQueryService SignalQueryService
@inject SignalReviewService SignalReviewService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudStack Spacing="3">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="summary-footer">
        <div>
            <MudText Typo="Typo.h4">Signal @Id</MudText>
            <MudText Typo="Typo.body1" Class="placeholder-line">Read-only signal detail.</MudText>
        </div>
        <MudButton Href="/signals" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ArrowBack">
            Signals
        </MudButton>
    </MudStack>

    @if (_loading)
    {
        <MudSkeleton Height="240px" Animation="Animation.Wave" />
        <MudSkeleton Height="240px" Animation="Animation.Wave" />
    }
    else if (_signal is null)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">Signal not found.</MudAlert>
    }
    else
    {
        <MudPaper Class="pa-4" Elevation="1">
            <MudStack Spacing="2">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="summary-footer">
                    <div>
                        <MudText Typo="Typo.h6">Review Workflow</MudText>
                        <MudText Typo="Typo.body2" Class="placeholder-line">@ReviewSummary</MudText>
                    </div>
                    <MudStack Row="true" Spacing="1">
                        <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.ThumbUp" OnClick="@(() => OpenReviewDialog("approve"))">
                            Approve
                        </MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.ThumbDown" OnClick="@(() => OpenReviewDialog("reject"))">
                            Reject
                        </MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Warning" StartIcon="@Icons.Material.Filled.Visibility" OnClick="@(() => OpenReviewDialog("watch"))">
                            Watch
                        </MudButton>
                    </MudStack>
                </MudStack>
                @if (!string.IsNullOrWhiteSpace(_review?.Note))
                {
                    <MudText Typo="Typo.body2">@_review.Note</MudText>
                }
            </MudStack>
        </MudPaper>

        <MudPaper Class="pa-4" Elevation="1">
            <MudGrid>
                <MudItem xs="12" sm="6" md="3">
                    <MudText Typo="Typo.overline">Ticker</MudText>
                    <MudText>@_signal.Ticker</MudText>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudText Typo="Typo.overline">Source</MudText>
                    <MudText>@_signal.Source</MudText>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudText Typo="Typo.overline">Discovered</MudText>
                    <MudText>@FormatDate(_signal.DiscoveredAt)</MudText>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudText Typo="Typo.overline">Status</MudText>
                    <MudText>@FormatText(_signal.Status)</MudText>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudText Typo="Typo.overline">Tier 1 Score</MudText>
                    <MudText>@FormatInt(_signal.Tier1Score)</MudText>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudText Typo="Typo.overline">Tier 1 Pass</MudText>
                    <MudText>@FormatTier1Pass(_signal.Tier1Pass)</MudText>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudText Typo="Typo.overline">Outcome</MudText>
                    <MudText>@FormatText(_signal.OutcomeStatus)</MudText>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudText Typo="Typo.overline">Rating</MudText>
                    <MudText>@FormatInt(_signal.Rating)</MudText>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudText Typo="Typo.overline">Triggered</MudText>
                    <MudText>@FormatDate(_signal.TriggeredAt)</MudText>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudText Typo="Typo.overline">Resolved</MudText>
                    <MudText>@FormatDate(_signal.ResolvedAt)</MudText>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudText Typo="Typo.overline">Monitoring Start</MudText>
                    <MudText>@FormatDate(_signal.MonitoringStart)</MudText>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudText Typo="Typo.overline">TTL Days</MudText>
                    <MudText>@FormatInt(_signal.TtlDays)</MudText>
                </MudItem>
                <MudItem xs="12">
                    <MudText Typo="Typo.overline">Outcome Note</MudText>
                    <MudText>@FormatText(_signal.OutcomeNote)</MudText>
                </MudItem>
            </MudGrid>
        </MudPaper>

        <MudPaper Class="pa-4" Elevation="1">
            <MudText Typo="Typo.h6">Raw Signal</MudText>
            <pre class="json-block">@_signal.RawSignal</pre>
        </MudPaper>

        <MudPaper Class="pa-4" Elevation="1">
            <MudText Typo="Typo.h6">Tier 1 Dimensions</MudText>
            <pre class="json-block">@_signal.Tier1DimsJson</pre>
        </MudPaper>

        <MudPaper Class="pa-4" Elevation="1">
            <MudText Typo="Typo.h6">Tier 2 Result</MudText>
            <pre class="json-block">@_signal.Tier2ResultJson</pre>
        </MudPaper>
    }
</MudStack>

@code {
    [Parameter]
    public int Id { get; set; }

    private SignalDetailDto? _signal;
    private SignalReviewDto? _review;
    private bool _loading = true;

    private string ReviewSummary => _review is null
        ? "No dashboard review has been saved yet."
        : $"{_review.Decision} | rating {_review.Rating?.ToString() ?? "-"} | {_review.Reviewer ?? "admin"} | {FormatDate(_review.UpdatedAt)}";

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _signal = await SignalQueryService.GetDetailAsync(Id);
        _review = await SignalReviewService.GetLatestReviewAsync(Id);
        _loading = false;
    }

    private async Task OpenReviewDialog(string decision)
    {
        var parameters = new DialogParameters<SignalReviewDialog>
        {
            { dialog => dialog.SignalId, Id },
            { dialog => dialog.Decision, decision },
            { dialog => dialog.CurrentRating, _review?.Rating ?? _signal?.Rating },
            { dialog => dialog.CurrentNote, _review?.Note }
        };

        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<SignalReviewDialog>($"Review signal {Id}", parameters, options);
        var result = await dialog.Result;

        if (result is null || result.Canceled || result.Data is not SignalReviewRequest request)
        {
            return;
        }

        await SignalReviewService.SaveReviewAsync(request);
        _review = await SignalReviewService.GetLatestReviewAsync(Id);
        Snackbar.Add($"Signal {Id} review saved.", Severity.Success);
    }

    private static string FormatDate(DateTime? value)
    {
        return value?.ToString("g") ?? "-";
    }

    private static string FormatInt(int? value)
    {
        return value?.ToString() ?? "-";
    }

    private static string FormatText(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? "-" : value;
    }

    private static string FormatTier1Pass(int? value)
    {
        return value switch
        {
            1 => "Pass",
            0 => "Reject",
            _ => "-"
        };
    }
}
