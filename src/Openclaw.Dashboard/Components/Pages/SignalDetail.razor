@page "/signals/{Id:int}"
@using Openclaw.Dashboard.Services
@inject SignalQueryService SignalQueryService
@inject SignalReviewService SignalReviewService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject DashboardTimeService DashboardTime

<MudStack Spacing="3">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="summary-footer">
        <div>
            <MudText Typo="Typo.h4">Signal @Id</MudText>
            <MudText Typo="Typo.body1" Class="placeholder-line">Read-only signal detail.</MudText>
        </div>
        <MudButton Href="/signals" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ArrowBack">
            Signals
        </MudButton>
    </MudStack>

    @if (_loading)
    {
        <MudSkeleton Height="240px" Animation="Animation.Wave" />
        <MudSkeleton Height="240px" Animation="Animation.Wave" />
    }
    else if (_signal is null)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">Signal not found.</MudAlert>
    }
    else
    {
        <MudPaper Class="pa-4" Elevation="1">
            <MudStack Spacing="2">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="summary-footer">
                    <div>
                        <MudText Typo="Typo.h6">Review Ratings</MudText>
                        <MudText Typo="Typo.body2" Class="placeholder-line">Rate capture, parsing, idea value, and trade planning separately.</MudText>
                    </div>
                </MudStack>
                @QualityRow("T0 Capture", "Should this raw item have been saved?", "tier0", _signal.Tier0Quality, _tier0Review)
                @QualityRow("T1 Parse", "Did extraction and classification match the source?", "tier1_parse", _signal.Tier1ParseQuality, _tier1ParseReview)
                @QualityRow("T1 Alpha", "Is the extracted idea worth attention?", "tier1_alpha", _signal.Tier1AlphaQuality, _tier1AlphaReview)
                @QualityRow("T2 Trade Plan", "Is the trade plan or review useful?", "tier2", _signal.Tier2Quality, _tier2Review)
            </MudStack>
        </MudPaper>

        <MudPaper Class="pa-4" Elevation="1">
            <MudGrid>
                <MudItem xs="12" sm="6" md="3">
                    <MudText Typo="Typo.overline">Ticker</MudText>
                    <MudText>@_signal.Ticker</MudText>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudText Typo="Typo.overline">Source</MudText>
                    <MudText>@_signal.SourceDisplay</MudText>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudText Typo="Typo.overline">Source Link</MudText>
                    @if (!string.IsNullOrWhiteSpace(_signal.Url))
                    {
                        <MudLink Href="@_signal.Url" Target="_blank" rel="noopener noreferrer">Open source</MudLink>
                    }
                    else
                    {
                        <MudText>-</MudText>
                    }
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudText Typo="Typo.overline">Discovered (ET)</MudText>
                    <MudText>@FormatDate(_signal.DiscoveredAt)</MudText>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudText Typo="Typo.overline">Status</MudText>
                    <MudText>@FormatText(_signal.Status)</MudText>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudText Typo="Typo.overline">Tier 1 Route</MudText>
                    <MudChip T="string" Size="Size.Small" Color="@RouteColor(_signal.Route)" Variant="@RouteVariant(_signal.Route)">
                        @FormatRoute(_signal.Route)
                    </MudChip>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudText Typo="Typo.overline">Alpha Score</MudText>
                    <MudText>@FormatInt(_signal.AlphaScore)</MudText>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudText Typo="Typo.overline">Readiness Score</MudText>
                    <MudText>@FormatInt(_signal.ReadinessScore)</MudText>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudText Typo="Typo.overline">Reason Category</MudText>
                    <MudText>@FormatText(_signal.ReasonCategory)</MudText>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudText Typo="Typo.overline">Tier 1 Score</MudText>
                    <MudText>@FormatInt(_signal.Tier1Score)</MudText>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudText Typo="Typo.overline">Tier 1 Pass</MudText>
                    <MudText>@FormatTier1Pass(_signal.Tier1Pass)</MudText>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudText Typo="Typo.overline">Outcome</MudText>
                    <MudText>@FormatText(_signal.OutcomeStatus)</MudText>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudText Typo="Typo.overline">T0 Capture</MudText>
                    <MudText>@FormatQuality(_signal.Tier0Quality)</MudText>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudText Typo="Typo.overline">T1 Legacy Parse</MudText>
                    <MudText>@FormatQuality(_signal.Tier1Quality)</MudText>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudText Typo="Typo.overline">T1 Parse</MudText>
                    <MudText>@FormatQuality(_signal.Tier1ParseQuality)</MudText>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudText Typo="Typo.overline">T1 Alpha</MudText>
                    <MudText>@FormatQuality(_signal.Tier1AlphaQuality)</MudText>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudText Typo="Typo.overline">T2 Trade Plan</MudText>
                    <MudText>@FormatQuality(_signal.Tier2Quality)</MudText>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudText Typo="Typo.overline">Triggered (ET)</MudText>
                    <MudText>@FormatDate(_signal.TriggeredAt)</MudText>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudText Typo="Typo.overline">Resolved (ET)</MudText>
                    <MudText>@FormatDate(_signal.ResolvedAt)</MudText>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudText Typo="Typo.overline">Monitoring Start (ET)</MudText>
                    <MudText>@FormatDate(_signal.MonitoringStart)</MudText>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudText Typo="Typo.overline">TTL Days</MudText>
                    <MudText>@FormatInt(_signal.TtlDays)</MudText>
                </MudItem>
                <MudItem xs="12">
                    <MudText Typo="Typo.overline">Next Action</MudText>
                    <MudText>@FormatText(_signal.NextAction)</MudText>
                </MudItem>
                <MudItem xs="12">
                    <MudText Typo="Typo.overline">Outcome Note</MudText>
                    <MudText>@FormatText(_signal.OutcomeNote)</MudText>
                </MudItem>
            </MudGrid>
        </MudPaper>

        <MudPaper Class="pa-4" Elevation="1">
            <MudText Typo="Typo.h6">Raw Signal</MudText>
            <pre class="json-block">@_signal.RawSignal</pre>
        </MudPaper>

        <MudPaper Class="pa-4" Elevation="1">
            <MudText Typo="Typo.h6">Tier 1 Dimensions</MudText>
            <pre class="json-block">@_signal.Tier1DimsJson</pre>
        </MudPaper>

        <MudPaper Class="pa-4" Elevation="1">
            <MudText Typo="Typo.h6">Tier 2 Result</MudText>
            <pre class="json-block">@_signal.Tier2ResultJson</pre>
        </MudPaper>
    }
</MudStack>

@code {
    [Parameter]
    public int Id { get; set; }

    private SignalDetailDto? _signal;
    private SignalReviewDto? _tier0Review;
    private SignalReviewDto? _tier1ParseReview;
    private SignalReviewDto? _tier1AlphaReview;
    private SignalReviewDto? _tier2Review;
    private bool _loading = true;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _signal = await SignalQueryService.GetDetailAsync(Id);
        _tier0Review = await SignalReviewService.GetLatestReviewAsync(Id, "tier0");
        _tier1ParseReview = await SignalReviewService.GetLatestReviewAsync(Id, "tier1_parse");
        _tier1AlphaReview = await SignalReviewService.GetLatestReviewAsync(Id, "tier1_alpha");
        _tier2Review = await SignalReviewService.GetLatestReviewAsync(Id, "tier2");
        _loading = false;
    }

    private RenderFragment QualityRow(string label, string prompt, string stage, string? quality, SignalReviewDto? review) => @<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="summary-footer">
        <div>
            <MudText Typo="Typo.body1">@label: @FormatQuality(quality)</MudText>
            <MudText Typo="Typo.body2" Class="placeholder-line">@prompt</MudText>
            <MudText Typo="Typo.caption" Class="placeholder-line">@FormatQualityMeta(review)</MudText>
        </div>
        <MudStack Row="true" Spacing="1">
            <MudButton Variant="Variant.Outlined" Color="Color.Success" StartIcon="@Icons.Material.Filled.ThumbUp" OnClick="@(() => OpenReviewDialog(stage, "good", review))">
                Good
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Warning" StartIcon="@Icons.Material.Filled.Remove" OnClick="@(() => OpenReviewDialog(stage, "medium", review))">
                Medium
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.ThumbDown" OnClick="@(() => OpenReviewDialog(stage, "bad", review))">
                Bad
            </MudButton>
        </MudStack>
    </MudStack>;

    private async Task OpenReviewDialog(string stage, string decision, SignalReviewDto? currentReview)
    {
        var parameters = new DialogParameters<SignalReviewDialog>
        {
            { dialog => dialog.SignalId, Id },
            { dialog => dialog.Stage, stage },
            { dialog => dialog.Decision, decision },
            { dialog => dialog.CurrentNote, currentReview?.Note }
        };

        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<SignalReviewDialog>($"Rate {FormatStage(stage)} for signal {Id}", parameters, options);
        var result = await dialog.Result;

        if (result is null || result.Canceled || result.Data is not SignalReviewRequest request)
        {
            return;
        }

        try
        {
            await SignalReviewService.SaveReviewAsync(request);
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            return;
        }

        _tier0Review = await SignalReviewService.GetLatestReviewAsync(Id, "tier0");
        _tier1ParseReview = await SignalReviewService.GetLatestReviewAsync(Id, "tier1_parse");
        _tier1AlphaReview = await SignalReviewService.GetLatestReviewAsync(Id, "tier1_alpha");
        _tier2Review = await SignalReviewService.GetLatestReviewAsync(Id, "tier2");
        _signal = await SignalQueryService.GetDetailAsync(Id);
        Snackbar.Add($"Signal {Id} {FormatStage(request.Stage)} rating saved.", Severity.Success);
    }

    private string FormatDate(DateTime? value)
    {
        return DashboardTime.FormatUtcAsDashboardTime(value);
    }

    private static string FormatInt(int? value)
    {
        return value?.ToString() ?? "-";
    }

    private static string FormatText(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? "-" : value;
    }

    private static string FormatQuality(string? value)
    {
        return value switch
        {
            "good" => "Good",
            "medium" => "Medium",
            "bad" => "Bad",
            _ => "-"
        };
    }

    private string FormatQualityMeta(SignalReviewDto? review)
    {
        return review is null
            ? "No label saved."
            : $"{review.Reviewer ?? "admin"} | {FormatDate(review.UpdatedAt)}";
    }

    private static string FormatStage(string? stage)
    {
        return stage switch
        {
            "tier0" => "T0 capture",
            "tier1" => "T1 legacy parse",
            "tier1_parse" => "T1 parse",
            "tier1_alpha" => "T1 alpha",
            "tier2" => "T2 trade plan",
            _ => "signal"
        };
    }

    private static string FormatTier1Pass(int? value)
    {
        return value switch
        {
            1 => "Pass",
            0 => "Reject",
            _ => "-"
        };
    }

    private static string FormatRoute(string? value)
    {
        return string.IsNullOrWhiteSpace(value)
            ? "-"
            : value.Replace('_', ' ');
    }

    private static Color RouteColor(string? route)
    {
        return route switch
        {
            "fast_track" => Color.Warning,
            "pass" => Color.Success,
            "watch" => Color.Info,
            "reject" => Color.Error,
            "new" => Color.Default,
            _ => Color.Default
        };
    }

    private static Variant RouteVariant(string? route)
    {
        return route is "fast_track" or "pass" or "watch" or "reject"
            ? Variant.Filled
            : Variant.Outlined;
    }
}
