@page "/signals"
@using Openclaw.Dashboard.Services
@inject SignalQueryService SignalQueryService
@inject DashboardTimeService DashboardTime

<MudStack Spacing="3">
    <div class="page-title">
        <MudText Typo="Typo.h4">Signals</MudText>
        <MudText Typo="Typo.body1" Class="placeholder-line">
            Paged read-only view of signals.db.
        </MudText>
    </div>

    <MudPaper Class="pa-4" Elevation="1">
        <MudGrid Spacing="2">
            <MudItem xs="12" sm="6" md="3">
                <MudSelect T="string" Label="Source" Dense="true" @bind-Value="_source">
                    <MudSelectItem Value="@string.Empty">All sources</MudSelectItem>
                    @foreach (var source in _sources)
                    {
                        <MudSelectItem Value="@source">@source</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6" md="2">
                <MudSelect T="string" Label="Outcome" Dense="true" @bind-Value="_outcomeStatus">
                    <MudSelectItem Value="@string.Empty">All outcomes</MudSelectItem>
                    <MudSelectItem Value="@("pending")">pending</MudSelectItem>
                    <MudSelectItem Value="@("triggered")">triggered</MudSelectItem>
                    <MudSelectItem Value="@("resolved")">resolved</MudSelectItem>
                    <MudSelectItem Value="@("expired")">expired</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6" md="2">
                <MudSelect T="string" Label="Queue" Dense="true" @bind-Value="_routeView">
                    <MudSelectItem Value="@string.Empty">All signals</MudSelectItem>
                    <MudSelectItem Value="@("unrouted")">New / unrouted</MudSelectItem>
                    <MudSelectItem Value="@("watch")">Watch</MudSelectItem>
                    <MudSelectItem Value="@("tier2_pending")">Pass + fast track</MudSelectItem>
                    <MudSelectItem Value="@("pass_pending")">Pass pending</MudSelectItem>
                    <MudSelectItem Value="@("fast_track_pending")">Fast track</MudSelectItem>
                    <MudSelectItem Value="@("rejected")">Rejected</MudSelectItem>
                    <MudSelectItem Value="@("tier2_complete")">Tier 2 complete</MudSelectItem>
                    <MudSelectItem Value="@("active")">Active / terminal</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6" md="2">
                <MudDatePicker Label="From" Margin="Margin.Dense" @bind-Date="_fromDate" />
            </MudItem>
            <MudItem xs="12" sm="6" md="2">
                <MudDatePicker Label="To" Margin="Margin.Dense" @bind-Date="_toDate" />
            </MudItem>
            <MudItem xs="12" sm="6" md="1">
                <MudTextField T="string" Label="Ticker" Margin="Margin.Dense" @bind-Value="_ticker" />
            </MudItem>
            <MudItem xs="12">
                <MudStack Row="true" Spacing="2">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ApplyFilters">Apply</MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="ResetFilters">Reset</MudButton>
                </MudStack>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudTable @ref="_table"
              T="SignalRow"
              ServerData="LoadSignals"
              Dense="true"
              Hover="true"
              Elevation="1"
              RowsPerPage="25">
        <HeaderContent>
            <MudTh>Ticker</MudTh>
            <MudTh>Dir</MudTh>
            <MudTh>Route</MudTh>
            <MudTh>Alpha</MudTh>
            <MudTh>Ready</MudTh>
            <MudTh>Parse Q</MudTh>
            <MudTh>Idea Q</MudTh>
            <MudTh>Reason</MudTh>
            <MudTh>Description</MudTh>
            <MudTh>Source</MudTh>
            <MudTh>Link</MudTh>
            <MudTh>Discovered (ET)</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Ticker">
                <MudLink Href="@($"/signals/{context.Id}")">@context.Ticker</MudLink>
            </MudTd>
            <MudTd DataLabel="Dir">@context.Direction</MudTd>
            <MudTd DataLabel="Route">
                <MudChip T="string" Size="Size.Small" Color="@RouteColor(context.Route)" Variant="@RouteVariant(context.Route)" Class="oc-route-chip">
                    @FormatRoute(context.Route)
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Alpha">@FormatInt(context.AlphaScore)</MudTd>
            <MudTd DataLabel="Ready">@FormatInt(context.ReadinessScore)</MudTd>
            <MudTd DataLabel="Parse Q">@FormatQuality(context.Tier1ParseQuality)</MudTd>
            <MudTd DataLabel="Idea Q">@FormatQuality(context.Tier1AlphaQuality)</MudTd>
            <MudTd DataLabel="Reason">@FormatText(context.ReasonCategory)</MudTd>
            <MudTd DataLabel="Description">
                <MudTooltip Text="@context.DescriptionTooltip" Placement="Placement.Bottom" Arrow="true">
                    <span class="signal-description">@context.Description</span>
                </MudTooltip>
            </MudTd>
            <MudTd DataLabel="Source">@context.SourceDisplay</MudTd>
            <MudTd DataLabel="Link">
                @if (!string.IsNullOrWhiteSpace(context.Url))
                {
                    <MudLink Href="@context.Url" Target="_blank" rel="noopener noreferrer">Open</MudLink>
                }
                else
                {
                    <span>-</span>
                }
            </MudTd>
            <MudTd DataLabel="Discovered">@FormatDate(context.DiscoveredAt)</MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Class="pa-4 placeholder-line">No signals match the current filters.</MudText>
        </NoRecordsContent>
        <LoadingContent>
            <MudText Class="pa-4 placeholder-line">Loading signals...</MudText>
        </LoadingContent>
        <PagerContent>
            <MudTablePager PageSizeOptions="new[] { 10, 25, 50, 100 }" />
        </PagerContent>
    </MudTable>
</MudStack>

@code {
    private MudTable<SignalRow>? _table;
    private IReadOnlyList<string> _sources = [];
    private string _source = string.Empty;
    private string _outcomeStatus = string.Empty;
    private string _routeView = string.Empty;
    private string? _ticker;
    private DateTime? _fromDate;
    private DateTime? _toDate;

    protected override async Task OnInitializedAsync()
    {
        _sources = await SignalQueryService.GetSourcesAsync();
    }

    private async Task<TableData<SignalRow>> LoadSignals(TableState state, CancellationToken cancellationToken)
    {
        var result = await SignalQueryService.SearchAsync(
            BuildFilters(),
            state.Page,
            state.PageSize,
            cancellationToken);

        return new TableData<SignalRow>
        {
            Items = result.Items,
            TotalItems = result.TotalItems
        };
    }

    private SignalFilters BuildFilters()
    {
        return new SignalFilters
        {
            Source = string.IsNullOrWhiteSpace(_source) ? null : _source,
            OutcomeStatus = string.IsNullOrWhiteSpace(_outcomeStatus) ? null : _outcomeStatus,
            RouteView = string.IsNullOrWhiteSpace(_routeView) ? null : _routeView,
            FromDate = _fromDate,
            ToDate = _toDate,
            Ticker = string.IsNullOrWhiteSpace(_ticker) ? null : _ticker
        };
    }

    private Task ApplyFilters()
    {
        return _table?.ReloadServerData() ?? Task.CompletedTask;
    }

    private Task ResetFilters()
    {
        _source = string.Empty;
        _outcomeStatus = string.Empty;
        _routeView = string.Empty;
        _ticker = null;
        _fromDate = null;
        _toDate = null;

        return ApplyFilters();
    }

    private string FormatDate(DateTime? value)
    {
        return DashboardTime.FormatUtcAsDashboardTime(value);
    }

    private static string FormatInt(int? value)
    {
        return value?.ToString() ?? "-";
    }

    private static string FormatText(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? "-" : value;
    }

    private static string FormatQuality(string? value)
    {
        return value switch
        {
            "good" => "Good",
            "medium" => "Medium",
            "bad" => "Bad",
            _ => "-"
        };
    }

    private static string FormatRoute(string? value)
    {
        return string.IsNullOrWhiteSpace(value)
            ? "-"
            : value.Replace('_', ' ');
    }

    private static Color RouteColor(string? route)
    {
        return route switch
        {
            "fast_track" => Color.Warning,
            "pass" => Color.Success,
            "watch" => Color.Info,
            "reject" => Color.Error,
            "new" => Color.Default,
            _ => Color.Default
        };
    }

    private static Variant RouteVariant(string? route)
    {
        return route is "fast_track" or "pass" or "watch" or "reject"
            ? Variant.Filled
            : Variant.Outlined;
    }

    private static string BuildShortText(string? value, int maxLength)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "-";
        }

        return value.Length <= maxLength ? value : $"{value[..(maxLength - 3)]}...";
    }
}
