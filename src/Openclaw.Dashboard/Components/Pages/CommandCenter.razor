@page "/"
@page "/command-center"

<MudStack Spacing="3">
    <div class="page-title">
        <MudText Typo="Typo.h4">Command Center</MudText>
        <MudText Typo="Typo.body1" Class="placeholder-line">
            Mission Control shell for Openclaw signals, trades, cron health, and review state.
        </MudText>
    </div>

    <MudGrid>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="metric-card pa-4" Elevation="1">
                <MudText Typo="Typo.overline">Signals</MudText>
                <MudText Typo="Typo.h4">--</MudText>
                <MudText Typo="Typo.body2" Class="placeholder-line">Awaiting database wiring</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="metric-card pa-4" Elevation="1">
                <MudText Typo="Typo.overline">Paper Trades</MudText>
                <MudText Typo="Typo.h4">--</MudText>
                <MudText Typo="Typo.body2" Class="placeholder-line">Portfolio data comes next</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="metric-card pa-4" Elevation="1">
                <MudText Typo="Typo.overline">Cron Jobs</MudText>
                <MudText Typo="Typo.h4">--</MudText>
                <MudText Typo="Typo.body2" Class="placeholder-line">Read-only status planned</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="metric-card pa-4" Elevation="1">
                <MudText Typo="Typo.overline">Reviews</MudText>
                <MudText Typo="Typo.h4">--</MudText>
                <MudText Typo="Typo.body2" Class="placeholder-line">Dashboard DB planned</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudPaper Class="pa-4" Elevation="1">
        <MudText Typo="Typo.h6">Build scope</MudText>
        <MudText Typo="Typo.body2" Class="placeholder-line">
            This first version has no database logic and does not run jobs. It is ready for EF Core mapping in the next phase.
        </MudText>
    </MudPaper>
</MudStack>
