@using Openclaw.Dashboard.Services

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                Admin confirmation is required. This writes @StageLabel quality to signals.db and an audit record to dashboard.db.
            </MudAlert>

            <MudSelect T="string" Label="@($"{StageLabel} Quality")" @bind-Value="_decision" Required="true">
                <MudSelectItem Value="@("good")">Good</MudSelectItem>
                <MudSelectItem Value="@("medium")">Medium / Neutral</MudSelectItem>
                <MudSelectItem Value="@("bad")">Bad</MudSelectItem>
            </MudSelect>

            <MudTextField T="string"
                          Label="Notes"
                          Lines="4"
                          MaxLength="2000"
                          Counter="2000"
                          @bind-Value="_note" />

            <MudTextField T="string"
                          Label="Reviewer"
                          HelperText="Defaults to admin."
                          @bind-Value="_reviewer" />

            <MudTextField T="string"
                          Label="Admin Token"
                          InputType="InputType.Password"
                          HelperText="Required for write actions."
                          @bind-Value="_adminToken" />

            <MudCheckBox T="bool"
                         Label="I confirm this admin write action."
                         Color="Color.Warning"
                         @bind-Value="_confirmed" />

            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@_error</MudAlert>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!_confirmed)" OnClick="Submit">
            Save Quality
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public int SignalId { get; set; }

    [Parameter]
    public string Stage { get; set; } = "tier0";

    [Parameter]
    public string Decision { get; set; } = "medium";

    [Parameter]
    public string? CurrentNote { get; set; }

    private string _decision = "medium";
    private string? _note;
    private string _reviewer = "admin";
    private string? _adminToken;
    private bool _confirmed;
    private string? _error;
    private string StageLabel => Stage switch
    {
        "tier0" => "Tier 0 raw signal",
        "tier1" => "Tier 1 classification",
        "tier2" => "Tier 2 trade plan",
        _ => "Signal"
    };

    protected override void OnInitialized()
    {
        Stage = Stage is "tier0" or "tier1" or "tier2" ? Stage : "tier0";
        _decision = string.IsNullOrWhiteSpace(Decision) ? "medium" : Decision;
        _note = CurrentNote;
    }

    private void Submit()
    {
        if (!_confirmed)
        {
            _error = "Admin confirmation is required.";
            return;
        }

        if (_decision is not ("good" or "medium" or "bad"))
        {
            _error = "Choose good, medium, or bad.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_adminToken))
        {
            _error = "Admin token is required.";
            return;
        }

        var request = new SignalReviewRequest(
            SignalId,
            Stage,
            _decision,
            _note,
            _reviewer,
            _adminToken);

        MudDialog.Close(DialogResult.Ok(request));
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }
}
